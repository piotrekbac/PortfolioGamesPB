<Window x:Class="DesktopGames.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopGames"
        mc:Ignorable="d"
        Title="Piotr Bacior - Portfolio - Memory game" Height="500" Width="400" Background="#2d3436">

    <!-- Definiuję style - wygląd naszych przycisków -->
    <Window.Resources>
        
        <!-- Ustawiam style dla kart memorów -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            
            <!-- Ustawiam wartości dla konkretnych parametrów jak margines, czcionka oraz kursor -->
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            
        </Style>
        
    </Window.Resources>
    
    <!-- Główny kontener naszej gry w memory -->
    <Grid>
        
        <!-- Definiujemy wiersze: górny - odpowiada za statystyki, a dolny - za plansze gry -->
        <Grid.RowDefinitions>
            
            <RowDefinition Height="50"/>    <!-- nagłówek -->
            <RowDefinition Height="*"/>     <!-- plansza gry -->
            
        </Grid.RowDefinitions>

        <!-- Definiujemy nagłówek (statystyki) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <!-- Definiujemy odpowiednie TextBlock'i z informacjami o statystykach -->
            <TextBlock x:Name="TimeTextBlock" Text="Czas: 00:00" FontSize="20" FontWeight="Bold" Margin="10"/>
            <TextBlock Text=" | " FontSize="20"/>
            <TextBlock Text="Ruchy: 0" FontSize="20" FontWeight="Bold" Margin="10"/>

            <!-- Definiujemy Button - Reset -->
            <Button Content="Reset" Width="60" Height="30" Margin="20,0,0,0"/>
        </StackPanel>
        
        <!-- Definiuję planszę gry (siatka 4x4) -->
        <!-- używamy UniformGrid dla podziału planszy na równe części -->
        <UniformGrid x:Name="GameGrid" Grid.Row="1" Rows="4" Columns="4" Margin="10">
            
            <!-- Ustawiamy na sztywno parę przycisków dla podgladu -->
            <Button Content="?" FontFamily="24" Margin="2"/>
            <Button Content="?" FontFamily="24" Margin="2"/>
            <Button Content="?" FontFamily="24" Margin="2"/>
            <Button Content="?" FontFamily="24" Margin="2"/>

            <Button Content="?" FontFamily="24" Margin="2"/>
            <Button Content="?" FontFamily="24" Margin="2"/>
            <Button Content="?" FontFamily="24" Margin="2"/>
            <Button Content="?" FontFamily="24" Margin="2"/>

            <Button Content="?" FontFamily="24" Margin="2"/>
            <Button Content="?" FontFamily="24" Margin="2"/>
            <Button Content="?" FontFamily="24" Margin="2"/>
            <Button Content="?" FontFamily="24" Margin="2"/>

            <Button Content="?" FontFamily="24" Margin="2"/>
            <Button Content="?" FontFamily="24" Margin="2"/>
            <Button Content="?" FontFamily="24" Margin="2"/>
            <Button Content="?" FontFamily="24" Margin="2"/>

        </UniformGrid>
        
    </Grid>
</Window>
